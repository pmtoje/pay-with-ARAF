# Pay with ARAF — environment template. Copy to .env (never commit .env).
# Generate local secrets with:  node scripts/generate-env.mjs > .env

# local | test | sandbox | uat | staging | production
APP_ENV=local
# The record environment this deployment serves. SANDBOX deployments never touch PRODUCTION records.
PLATFORM_ENVIRONMENT=SANDBOX

# Local default. For a hosted Postgres (e.g. Supabase):
#   migrations:   direct (db.<project-ref>.supabase.co:5432) or session pooler (<region>.pooler.supabase.com:5432)
#   API/worker:   session pooler (...:5432) or transaction pooler (...:6543?pgbouncer=true&connection_limit=1)
# New Supabase projects expose the direct host over IPv6 only; use the session pooler if your host/machine is IPv4-only.
# URL-encode special characters in the password (e.g. $ -> %24). The pooler user is `postgres.<project-ref>`,
# not `postgres`, and the pooler host is `<region>.pooler.supabase.com`, not `db.<project-ref>.supabase.co`.
DATABASE_URL=postgresql://araf:araf_local_dev@localhost:5432/araf
REDIS_URL=redis://localhost:6379

# API listen port. Hosts like Render set PORT automatically; API_PORT overrides it when set.
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
CHECKOUT_BASE_URL=http://localhost:3001
PARTNER_PORTAL_URL=http://localhost:3002
ADMIN_PORTAL_URL=http://localhost:3003
DEVELOPER_PORTAL_URL=http://localhost:3004
ALTMALL_URL=http://localhost:3005

# AltMall demo store database (apps/altmall-demo). Locally this defaults to a separate `altmall` database.
# If AltMall shares the Pay with ARAF Supabase project, use the dedicated role and schema instead
# (provision once with infrastructure/supabase/altmall-schema.sql):
# ALTMALL_DATABASE_URL=postgresql://altmall_app.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require
# Use port 5432 (session pooler) outside serverless. node-postgres needs uselibpqcompat=true; plain
# sslmode=require is treated as verify-full by pg 8 and fails against Supabase's certificate chain.
# ALTMALL_DB_SCHEMA=altmall
# ALTMALL_DB_POOL_MAX=1   # serverless/Vercel: keep the pool small

# Secrets (base64 32-byte keys / random strings). MUST come from the Bank's secrets manager outside local.
ENCRYPTION_KEYS='{"k1":"<base64-32-bytes>"}'
ENCRYPTION_ACTIVE_KEY=k1
BLIND_INDEX_KEY=<random>
API_KEY_PEPPER=<random>
OTP_PEPPER=<random>
STATE_TOKEN_KEY=<random>
INTERNAL_CALLBACK_SECRET=<random>

# Connection to the AltBank Retail Asset Factory (ARAF), a separate application (documentation/ARAF_CONNECTION.md).
# simulator = built-in sandbox workflow; connected = submit to the real ARAF and follow its signed decisions.
ARAF_MODE=simulator
# ARAF_BASE_URL=http://localhost:3000
# ARAF_INTEGRATION_SECRET=<random, at least 32 characters; the same value as ARAF's PAY_WITH_ARAF_SECRET>
# Bank staff sign in to the admin portal with their ARAF (@altbank.ng) account.
ARAF_SSO_ENABLED=false
STAFF_EMAIL_DOMAINS=altbank.ng,sandbox.altbank.example

STORAGE_DIR=./storage
COOKIE_SECURE=false
# Local only: allow webhooks to http://localhost (the AltMall demo). Must be false in any shared environment.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
# Delay before simulated asynchronous provider operations complete (ms).
SANDBOX_ASYNC_DELAY_MS=1500
# Live financial operations master switch. Remains false until every production gate is signed off.
LIVE_OPERATIONS_ENABLED=false
