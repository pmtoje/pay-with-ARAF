# Pay with ARAF — PRODUCTION on araf.ng (template; never commit real values)
# Secrets marked <secrets-manager> come from the Bank's secrets manager / KMS at deploy time.
APP_ENV=production
PLATFORM_ENVIRONMENT=PRODUCTION
LIVE_OPERATIONS_ENABLED=false            # stays false until every PRODUCTION_READINESS gate is signed off
COOKIE_SECURE=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
TRUST_PROXY_HOPS=2                       # edge proxy (overwrites X-Forwarded-For) + web app /api proxy

# Public URLs (all HTTPS — production refuses to start otherwise)
PUBLIC_API_URL=https://api.araf.ng
CHECKOUT_BASE_URL=https://www.araf.ng                # hosted checkout /c/{session} + embed SDK /v1/araf.js
PARTNER_PORTAL_URL=https://partners.araf.ng
ADMIN_PORTAL_URL=https://admin.araf.ng               # resolvable on the Bank's internal DNS / VPN only
DEVELOPER_PORTAL_URL=https://developers.araf.ng

# Private network (never exposed)
DATABASE_URL=<secrets-manager>
REDIS_URL=<secrets-manager>
ENCRYPTION_KEYS=<secrets-manager>
ENCRYPTION_ACTIVE_KEY=<secrets-manager>
BLIND_INDEX_KEY=<secrets-manager>
API_KEY_PEPPER=<secrets-manager>
OTP_PEPPER=<secrets-manager>
STATE_TOKEN_KEY=<secrets-manager>
INTERNAL_CALLBACK_SECRET=<secrets-manager>

# SeedFi and Periculum (real providers; production refuses SeedFi test/dummy responses).
SEEDFI_MODE=connected
SEEDFI_BASE_URL=https://loanengine.theseedfi.com
SEEDFI_API_KEY=<secrets-manager>
PERICULUM_MODE=connected
PERICULUM_CLIENT_ID=<secrets-manager>
PERICULUM_CLIENT_SECRET=<secrets-manager>
# Email delivery through Resend. EMAIL_FROM must be a verified Resend sender/domain.
RESEND_API_KEY=<secrets-manager>
EMAIL_FROM=no-reply@pay.araf.ng

# Real ARAF (documentation/ARAF_CONNECTION.md). The secret equals ARAF's PAY_WITH_ARAF_SECRET.
ARAF_MODE=connected
ARAF_BASE_URL=https://<araf-host>
ARAF_INTEGRATION_SECRET=<secrets-manager>
ARAF_SSO_ENABLED=true
STAFF_EMAIL_DOMAINS=altbank.ng

# Web apps (server side: reach the API over the private network)
ARAF_API_URL=http://araf-api.internal:4000
# Web apps (build time — Next.js inlines NEXT_PUBLIC_* when the image is built)
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=https://developers.araf.ng
NEXT_PUBLIC_PARTNER_PORTAL_URL=https://partners.araf.ng
NEXT_PUBLIC_CHECKOUT_URL=https://www.araf.ng
NEXT_PUBLIC_API_URL=https://api.araf.ng
NEXT_PUBLIC_ARAF_API_BASE_URL=https://api.araf.ng/api/v1
