# Pay with ARAF — SANDBOX on araf.ng (synthetic data and simulators only)
APP_ENV=sandbox
PLATFORM_ENVIRONMENT=SANDBOX
COOKIE_SECURE=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
TRUST_PROXY_HOPS=2                       # edge proxy (overwrites X-Forwarded-For) + web app /api proxy

PUBLIC_API_URL=https://api.sandbox.araf.ng
CHECKOUT_BASE_URL=https://sandbox.araf.ng            # sandbox checkout + SDK https://sandbox.araf.ng/v1/araf.js
PARTNER_PORTAL_URL=https://partners.sandbox.araf.ng
ADMIN_PORTAL_URL=https://admin.sandbox.araf.ng       # internal DNS / VPN only
DEVELOPER_PORTAL_URL=https://developers.araf.ng      # one docs site for both environments
ALTMALL_URL=https://demo.sandbox.araf.ng             # Bank-hosted demo store (sandbox only)
ARAF_CHECKOUT_ORIGIN=https://sandbox.araf.ng         # demo store: where it loads the SDK / frames the checkout

DATABASE_URL=<secrets-manager>
REDIS_URL=<secrets-manager>
ENCRYPTION_KEYS=<secrets-manager>
ENCRYPTION_ACTIVE_KEY=<secrets-manager>
BLIND_INDEX_KEY=<secrets-manager>
API_KEY_PEPPER=<secrets-manager>
OTP_PEPPER=<secrets-manager>
STATE_TOKEN_KEY=<secrets-manager>
INTERNAL_CALLBACK_SECRET=<secrets-manager>

# Sandbox may stay on the simulator, or connect to ARAF's staging instance (documentation/ARAF_CONNECTION.md).
ARAF_MODE=simulator
# ARAF_BASE_URL=https://<araf-staging-host>
# ARAF_INTEGRATION_SECRET=<secrets-manager>
ARAF_SSO_ENABLED=false
STAFF_EMAIL_DOMAINS=altbank.ng,sandbox.altbank.example

ARAF_API_URL=http://araf-api.internal:4000
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=https://developers.araf.ng
NEXT_PUBLIC_PARTNER_PORTAL_URL=https://partners.sandbox.araf.ng
NEXT_PUBLIC_CHECKOUT_URL=https://sandbox.araf.ng
NEXT_PUBLIC_API_URL=https://api.sandbox.araf.ng
NEXT_PUBLIC_ARAF_API_BASE_URL=https://api.sandbox.araf.ng/api/v1
